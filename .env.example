# 로컬 PostGIS (docker compose up -d)
DATABASE_URL=postgresql://mapgpt:mapgpt@localhost:5432/mapgpt
# 통합 테스트용 DB (없으면 테스트가 생성)
TEST_DATABASE_URL=postgresql://mapgpt:mapgpt@localhost:5432/mapgpt_test

# LLM 공급자: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Dataset 후보 검색(pgvector) 임베딩 모델. LLM_PROVIDER=ollama여도 OPENAI_API_KEY가 필요하다
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=granite4.1:8b
# thinking 모델의 추론 강도 (none이면 thinking을 꺼서 크게 빨라짐). 비우면 모델 기본값
OLLAMA_REASONING_EFFORT=

# 서울 열린데이터광장 인증키 (어린이집 ChildCareInfo API)
SEOUL_OPEN_API_KEY=
